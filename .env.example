# Copia para .env e preenche. O .env nunca vai para o repositório.

# --- Claude (obrigatório) ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 responde mais depressa e sai muito mais barato para o dia a dia
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Voz ---
# Vozes Piper, 100% locais (descarrega-as com ./scripts/download_voices.sh)
PIPER_VOICE_EN=en_GB-alan-medium
PIPER_VOICE_PT=pt_PT-tugao-medium

# --- Ouvido (Whisper local) ---
# tiny | base | small  (small percebe melhor, mas demora mais no CPU)
WHISPER_MODEL=base
# Idioma da saudação inicial: pt | en
DEFAULT_LANGUAGE=pt

# --- Outros ---
DEFAULT_CITY=Lisboa
