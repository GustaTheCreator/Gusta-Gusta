# Copia para .env e preenche. O .env nunca vai para o repositório.

# --- Claude (obrigatório) ---
# Usa a subscrição Claude (Agent SDK), sem custo por token. Gera o token numa máquina com o
# Claude Code (`claude setup-token`) e cola-o aqui. Não uses ANTHROPIC_API_KEY: cobraria por token.
CLAUDE_CODE_OAUTH_TOKEN=
# claude-haiku-5-5 responde mais depressa e sai muito mais barato para o dia a dia
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
# Modelo que revê cada conversa no fim e decide o que guardar na memória (por omissão, o CLAUDE_MODEL)
# MEMORY_MODEL=claude-haiku-5-5

# --- Voz natural (ElevenLabs): sem chave usa a Piper abaixo. O plano grátis dá ~10 000 caracteres/mês ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # Daniel (britânico); em Voices > Default voices escolhes outra
# --- Reserva inglesa (Piper, 100% local; descarrega-a com ./scripts/download_voices.sh) ---
PIPER_VOICE=en_GB-alan-medium

# --- Ouvido (Whisper local, só português) ---
# tiny | base | small | medium  (small é o mínimo para português; base é mais rápido mas erra mais)
WHISPER_MODEL=small
# 1 é o mais rápido; 3 a 5 percebe melhor
WHISPER_BEAM_SIZE=3

# --- Outros ---
DEFAULT_CITY=Lisbon
