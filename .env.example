# Copia para .env e preenche. O .env nunca vai para o repositório.

# --- Claude (obrigatório) ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 responde mais depressa e sai muito mais barato para o dia a dia
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Voz ---
# azure: vozes neurais fluidas (Ryan em inglês, Duarte em pt-PT). O escalão gratuito F0 chega para uso pessoal.
# piper: 100% local, sem contas, mas menos natural.
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE_EN=en-GB-RyanNeural
AZURE_VOICE_PT=pt-PT-DuarteNeural
PIPER_VOICE_EN=en_GB-alan-medium
PIPER_VOICE_PT=pt_PT-tugao-medium

# --- Ouvido (Whisper local) ---
# tiny | base | small  (small percebe melhor, mas demora mais no CPU)
WHISPER_MODEL=base
# Idioma da saudação inicial: pt | en
DEFAULT_LANGUAGE=pt

# --- Outros ---
DEFAULT_CITY=Lisboa
